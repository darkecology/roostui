{
  "name": "roostui",
  "version": "0.1.0",
  "description": "Roost visualization and annotation web interface",
  "main": "js/vis.js",
  "scripts": {
    "build": "npm-run-all -s build:roostui build:roostui:dist build:viewer build:viewer:dist",
    "build:roostui": "rollup -c",
    "build:roostui:dist": "rollup -c --environment BUILD:production",
    "build:viewer": "rollup -c viewer/rollup.config.js",
    "build:viewer:dist": "rollup -c viewer/rollup.config.js --environment BUILD:production",
    "watch": "npm-run-all -s build -p watch:roostui watch:roostui:dist watch:viewer watch:viewer:dist",
    "watch:roostui": "rollup -w -c",
    "watch:roostui:dist": "rollup -w -c --environment BUILD:production",
    "watch:viewer": "rollup -w -c viewer/rollup.config.js",
    "watch:viewer:dist": "rollup -w -c viewer/rollup.config.js --environment BUILD:production",
    "serve": "http-server -p 8888 --cors",
    "watch-serve": "npm-run-all -p serve watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darkecology/roostui.git"
  },
  "keywords": [
    "radar",
    "biology",
    "birds",
    "roosts"
  ],
  "author": "Dan Sheldon <sheldon@cs.umass.edu> (https://people.cs.umass.edu/~sheldon)",
  "contributors": [
    "Aroma Rodrigues <aprodrigues@umass.edu>"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/darkecology/roostui/issues"
  },
  "homepage": "https://github.com/darkecology/roostui#readme",
  "dependencies": {
    "d3": "^6.6.0",
    "sprintf": "^0.1.5",
    "suncalc": "^1.9.0",
    "tippy.js": "^6.3.7",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.13.10",
    "@babel/plugin-external-helpers": "^7.12.13",
    "@babel/plugin-proposal-class-properties": "^7.13.0",
    "@babel/plugin-transform-runtime": "^7.13.10",
    "@babel/preset-env": "^7.13.10",
    "@rollup/plugin-babel": "^5.3.0",
    "@rollup/plugin-commonjs": "^17.1.0",
    "@rollup/plugin-node-resolve": "^11.2.0",
    "@rollup/plugin-replace": "5.0.5",
    "http-server": "^0.11.1",
    "npm-run-all": "^4.1.5",
    "rollup": "^2.42.0",
    "rollup-plugin-uglify": "^6.0.4"
  }
}
